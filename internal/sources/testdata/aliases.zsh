# Generated by alias manager
# Do not edit manually - changes will be overwritten

# Function wrapper to auto-source aliases after running alias commands
# This ensures new/updated aliases are immediately available in your shell
aliases() {
	if [ $# -eq 0 ]; then
		local cmd=$(CLICOLOR_FORCE=1 command aliases -i)
		if [[ -n "$cmd" ]]; then
			eval "$cmd"
		fi
	else
		command aliases "$@"
	fi
}

alias ..="cd .."
alias ...="cd ../.."
alias r="exec zsh" # Reload zsh config
alias o='open ./' # Open - in finder
alias rf="rm -rf" # Remove recursive
alias gs=git\ status
alias -s {js,mjs,json,ts}="$EDITOR"
alias -s git="git_clone" # open git urls with custom function
alias -g G="| rg" # grep output
alias -g T="2>&1 | tee output.log" # copy output to output.log
alias -g C=""
alias hash="echo '#not a comment'" # real comment
  alias indented="echo indented"
